# Токен бота від @BotFather (обов'язково)
BOT_TOKEN=your_bot_token_here
# Юзернейм бота без @ — для посилань і підписів «завантажено через @...»
BOT_USERNAME=SaveMDLBot
# Адреса локального Telegram Bot API Server (auto_deploy.sh піднімає його на 127.0.0.1:8081)
LOCAL_API_SERVER_URL=http://127.0.0.1:8081

# Дані для запуску Local Telegram Bot API Server (отримати на my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Список Telegram ID адміністраторів (через кому)
ADMIN_IDS=12345678,87654321

# (Опціонально) ID каналу/чату, куди бот шле звіти про критичні помилки завантаження.
# Бот має бути там адміністратором. Порожньо — звіти лише в логах.
ERROR_LOG_CHANNEL_ID=-1001234567890

# Домени через кому, для яких дозволено CORS до API (наприклад, для Telegram Mini App)
ALLOWED_CORS_ORIGINS=https://dmytrokurochkin.github.io

# (Опціонально) Повна адреса сторінки Mini App (статичні файли з webapp/, напр. на GitHub Pages).
# Форк має вказати власну, інакше його користувачі відкриватимуть фронтенд з цього репозиторію.
WEBAPP_URL=https://dmytrokurochkin.github.io/Media-Downloader-Bot/webapp/index.html

# Адреса й порт, на яких слухає внутрішній API бота. За замовчуванням лише localhost:
# назовні його виставляє ngrok або reverse-proxy з HTTPS. 0.0.0.0 ставити не потрібно.
API_HOST=127.0.0.1
API_PORT=8080

# Публічний URL, за яким доступний внутрішній API бота (пошук/публічні профілі в Mini App).
# Якщо використовуєте ngrok (див. NGROK_* нижче) - auto_deploy.sh підставить його автоматично.
PUBLIC_API_URL=http://127.0.0.1:8080/api

# (Опціонально) ngrok-тунель для PUBLIC_API_URL, налаштовується через auto_deploy.sh.
# Токен: https://dashboard.ngrok.com/get-started/your-authtoken
# Домен: зарезервований static domain з ngrok (щоб URL не змінювався при кожному рестарті).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# (Опціонально) ID приватного каналу-сховища для гостьового режиму. Бот вантажить туди файл,
# щоб отримати file_id і відповісти в чаті, куди його покликали. Бот має бути адміністратором
# каналу. Порожньо — файл іде в особисті тому, хто покликав бота (не працює, якщо людина
# ще не запускала бота).
STORAGE_CHAT_ID=

# (Опціонально) Браузер, з якого yt-dlp братиме cookies: firefox, chrome, chromium тощо.
# Для локальної розробки. На сервері замість цього кладіть cookies.txt у корінь проєкту.
YTDLP_COOKIES_FROM_BROWSER=

# (Опціонально) Абсолютний шлях до ffmpeg.exe, якщо він не доданий у PATH (актуально для Windows).
# На Linux-сервері (auto_deploy.sh) можна залишити порожнім - буде використано ffmpeg з PATH.
FFMPEG_PATH=
